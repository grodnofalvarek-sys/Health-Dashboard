{
  "name": "health-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Персональный медицинский дашборд (PWA). В репозитории — только код и зашифрованные данные.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "guard:staged": "node scripts/check-public.mjs --staged",
    "guard:repo": "node scripts/check-public.mjs --repo",
    "guard:dist": "node scripts/check-public.mjs --dist",
    "setup-hooks": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
