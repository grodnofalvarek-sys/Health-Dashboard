@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ============================================================================
echo [1/3] Сборка health_db.json и шифрование данных AES-256-GCM (public/data/*.enc)
echo ============================================================================
node scripts/encrypt-data.mjs
if errorlevel 1 (
  echo [ОШИБКА] Шифрование прервано.
  pause
  exit /b 1
)
echo.
echo ============================================================================
echo [2/3] Проверка безопасности репозитория (Data-Leak Guard)...
echo ============================================================================
node scripts/check-public.mjs --repo
if errorlevel 1 (
  echo [БЛОКИРОВКА] Обнаружены незашифрованные данные! Публикация отменена.
  pause
  exit /b 1
)
echo.
echo ============================================================================
echo [3/3] Проверка сборки production-бандла PWA...
echo ============================================================================
call npm.cmd run build
if errorlevel 1 (
  echo [ОШИБКА] Сборка приложения завершилась с ошибкой.
  pause
  exit /b 1
)
node scripts/check-public.mjs --dist
echo.
echo ============================================================================
echo ГОТОВО! Зашифрованные контейнеры обновлены в app/public/data/*.enc.
echo Теперь откройте GitHub Desktop -> Commit to main -> Push origin.
echo ============================================================================
pause
